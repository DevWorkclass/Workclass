# Environnement & secrets
.env.local
.env.development
.env.staging
.env.production
.env.test
!.env.example

# Node.js
node_modules/
dist/
build/
coverage/
*.log

# Next.js
frontend/.next/
frontend/out/
frontend/.vercel/

# Backend
backend/dist/
backend/coverage/
backend/uploads/

# Prisma
backend/prisma/*.db
backend/prisma/migrations/*/migration_lock.toml

# Misc
.DS_Store
Thumbs.db
