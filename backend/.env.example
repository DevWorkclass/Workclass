# ============================================================================
# Backend Work Class Gabon — Variables d'environnement (exemple)
# ============================================================================

NODE_ENV="development"
PORT="3001"
API_BASE_PATH="/api"

# --- URLs ---
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# --- Base de données PostgreSQL (Prisma) ---
DATABASE_URL="postgresql://workclass:workclass@localhost:5432/workclass?schema=public"

# --- Redis (cache + rate-limit distribué) ---
REDIS_URL="redis://localhost:6379"

# --- Sécurité / Signature ---
QR_HMAC_SECRET=""
FEEDBACK_TOKEN_SECRET=""
JWT_SECRET=""
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET=""

# --- Emails (Resend — en dev : simulé via logs si absent) ---
RESEND_API_KEY=""
EMAIL_FROM="no-reply@workclass-gabon.com"
EMAIL_FROM_ADDRESS="no-reply@workclass-gabon.com"
EMAIL_FROM_NAME="Work Class Gabon"

# --- Stockage local des PDFs (tickets, certificats) ---
LOCAL_STORAGE_PATH="./uploads"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"

# --- Logs ---
LOG_LEVEL="info"
