# ============================================================================
# Backend Work Class Gabon — Variables d'environnement (exemple)
# ============================================================================

NODE_ENV="development"
PORT="3001"
API_BASE_PATH="/api"

# --- CORS ---
CORS_ORIGIN="http://localhost:3000"

# --- Base de données PostgreSQL (Prisma) ---
DATABASE_URL="postgresql://workclass:workclass@localhost:5432/workclass?schema=public"

# --- Redis (cache + rate-limit distribué) ---
REDIS_URL="redis://localhost:6379"

# --- Supabase (optionnel — Auth/Storage uniquement) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Sécurité / Signature ---
QR_HMAC_SECRET=""
FEEDBACK_TOKEN_SECRET=""
JWT_SECRET=""
JWT_EXPIRES_IN="1h"

# --- Emails (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="no-reply@workclass-gabon.com"
EMAIL_FROM_NAME="Work Class Gabon"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"

# --- Logs ---
LOG_LEVEL="info"
