# ============================================================================
# Backend Work Class Gabon — Variables d'environnement (exemple)
# ============================================================================

NODE_ENV="development"
PORT="3001"
API_BASE_PATH="/api"

# --- URLs ---
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# --- Base de données PostgreSQL (Prisma) ---
# Dev local (docker-compose) :
#   postgresql://workclass:workclass@localhost:5432/workclass?schema=public
# Supabase prod (Settings → Database → Connection string → URI) :
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://workclass:workclass@localhost:5432/workclass?schema=public"

# Direct connection (port 5432) — requise par Prisma pour les migrations quand pgbouncer est actif.
# En dev local : DIRECT_URL = DATABASE_URL.
DIRECT_URL="postgresql://workclass:workclass@localhost:5432/workclass?schema=public"

# --- Supabase (Storage / Auth — optionnel, utilisé par backend/src/config/supabase.ts) ---
# Settings → API : Project URL + service_role secret key
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# --- Redis (cache + rate-limit distribué) ---
REDIS_URL="redis://localhost:6379"

# --- Sécurité / Signature ---
QR_HMAC_SECRET=""
FEEDBACK_TOKEN_SECRET=""
JWT_SECRET=""
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET=""

# --- Emails (Resend — en dev : simulé via logs si absent) ---
RESEND_API_KEY=""
EMAIL_FROM="no-reply@workclass-gabon.com"
EMAIL_FROM_ADDRESS="no-reply@workclass-gabon.com"
EMAIL_FROM_NAME="Work Class Gabon"

# --- Stockage local des PDFs (tickets, certificats) ---
LOCAL_STORAGE_PATH="./uploads"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"

# --- Logs ---
LOG_LEVEL="info"

# --- Documentation API (Swagger UI sur /api/docs) ---
# Mettre "false" pour désactiver l'exposition de la doc (ex. prod publique).
DOCS_ENABLED="true"

# --- Seed (comptes admin de démarrage) ---
# Mot de passe du super admin générique (admin@workclass-gabon.com).
SEED_ADMIN_PASSWORD=""
# Super admin nommé : créé/mis à jour UNIQUEMENT si le mot de passe est fourni.
SEED_SUPERADMIN_EMAIL="siatyler7@gmail.com"
SEED_SUPERADMIN_PASSWORD=""
