# ============================================================================
# Frontend Work Class Gabon — Variables d'environnement (exemple)
# Uniquement les variables nécessaires côté client (NEXT_PUBLIC_*)
# et les Route Handlers Next.js. Les secrets backend sont dans backend/.env
# ============================================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME="Work Class Gabon"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# --- API Backend Express (toute la logique métier) ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- Observabilité (optionnel) ---
NEXT_PUBLIC_SENTRY_DSN=""
