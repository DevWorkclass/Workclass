# ============================================================================
# Frontend Work Class Gabon — Variables d'environnement (exemple)
# Uniquement les variables `NEXT_PUBLIC_*` (exposées au navigateur).
# Les secrets backend (DB, JWT, HMAC) sont dans backend/.env.
# ============================================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME="Work Class Gabon"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# --- API Backend Express ---
# Dev   : http://localhost:3001/api
# Prod  : https://workclass-backend.onrender.com/api
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- Observabilité (optionnel) ---
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_API_URL="http://localhost:3001/api"